# Caddy — routeur interne derrière le tunnel Cloudflare.
# TLS est terminé au bord Cloudflare ; en interne on sert en HTTP simple.
{
	auto_https off
	admin off
}

# Site web (client + merchant + admin)
http://{$DOMAIN} {
	encode zstd gzip

	# Uploads servis directement par Caddy avec cache long (edge-cachés par Cloudflare).
	handle_path /u/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:3000
	}
}

# API
http://{$API_DOMAIN} {
	encode zstd gzip
	# SSE : pas de buffering, connexions longues.
	reverse_proxy api:3001 {
		flush_interval -1
	}
}
