{
  "name": "@baraka/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contrat du domaine partagé : Money, enums, machine à états commandes, DTOs Zod, constantes d'impact.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money.ts",
    "./enums": "./src/enums.ts",
    "./orders": "./src/orders/state-machine.ts",
    "./dto": "./src/dto/index.ts",
    "./impact": "./src/impact.ts",
    "./format": "./src/format.ts",
    "./photos": "./src/photos.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@baraka/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
