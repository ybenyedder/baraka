# ─────────────────────────────────────────────────────────────
# Baraka — variables de la stack de production (Raspberry Pi)
# Copier vers infra/compose/.env
# ─────────────────────────────────────────────────────────────

# Registre d'images & tag (poussés par la CI sur GHCR)
REGISTRY=ghcr.io/ybenyedder
TAG=latest

# Domaines (gérés par Cloudflare ZeroTrust Tunnel → localhost:8080 → Caddy).
# Caddy route DOMAIN vers le web (Next.js) et API_DOMAIN vers l'API (Fastify).
DOMAIN=baraka.webtvmedia.net
API_DOMAIN=apis.webtvmedia.net
PUBLIC_WEB_URL=https://baraka.webtvmedia.net
PUBLIC_API_URL=https://apis.webtvmedia.net
# CORS : origine du web (+ API mobile = requêtes natives, pas soumises au CORS navigateur).
CORS_ORIGINS=https://baraka.webtvmedia.net
# Uploads servis par Caddy depuis l'origine du web (mono-domaine).
STORAGE_PUBLIC_URL=https://baraka.webtvmedia.net/u

# Base de données
POSTGRES_USER=baraka
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=baraka

# Secrets applicatifs
AUTH_SECRET=generer_avec_openssl_rand_hex_32

# Paiements
PAYMENT_PROVIDERS=cash,konnect
KONNECT_API_URL=https://api.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Notifications push
EXPO_ACCESS_TOKEN=

# Cloudflare Tunnel (token du connecteur)
CLOUDFLARE_TUNNEL_TOKEN=

# Observabilité
SENTRY_DSN=
