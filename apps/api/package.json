{
  "name": "@baraka/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API Fastify + worker de jobs (pg-boss). Source de vérité métier.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/scripts/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "lint": "eslint . --max-warnings=0",
    "openapi": "tsx src/scripts/emit-openapi.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@baraka/db": "workspace:*",
    "@baraka/i18n": "workspace:*",
    "@baraka/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@baraka/config": "workspace:*",
    "@types/node": "^20.14.0",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
