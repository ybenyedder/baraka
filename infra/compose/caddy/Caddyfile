# Caddy — routeur interne derrière le tunnel Cloudflare.
# TLS est terminé au bord Cloudflare ; en interne on sert en HTTP simple.
{
	auto_https off
	admin off
}

# Site web (client + merchant + admin)
http://{$DOMAIN} {
	encode zstd gzip

	# Uploads servis directement par Caddy avec cache long (edge-cachés par Cloudflare).
	handle_path /u/* {
		root * /srv/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# API mono-origine : /v1/* routé vers le conteneur API (SSE : pas de buffering).
	# Next.js ne proxifie plus en prod (rewrites évaluées au build), Caddy le fait.
	handle /v1/* {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	# Healthcheck (utile pour le monitoring mono-domaine).
	handle /healthz {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}

# API
http://{$API_DOMAIN} {
	encode zstd gzip
	# SSE : pas de buffering, connexions longues.
	reverse_proxy api:3001 {
		flush_interval -1
	}
}
