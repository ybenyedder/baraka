# ─────────────────────────────────────────────────────────────
# Baraka — variables d'environnement (copier vers .env)
# ─────────────────────────────────────────────────────────────

# --- Général ---
NODE_ENV=development
# URL publique de l'API (utilisée par web + mobile + liens de paiement)
PUBLIC_API_URL=http://localhost:3001
# URL publique du site web (universal links, emails, redirections paiement)
PUBLIC_WEB_URL=http://localhost:3000

# --- Base de données (PostgreSQL + PostGIS) ---
POSTGRES_USER=baraka
POSTGRES_PASSWORD=baraka_dev_password
POSTGRES_DB=baraka
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://baraka:baraka_dev_password@localhost:5432/baraka

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
# Secret de signature des sessions/tokens (générer : openssl rand -hex 32)
AUTH_SECRET=change_me_openssl_rand_hex_32
# Origines autorisées CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Auth sociale ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Stockage des images ---
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
# Base URL servie par Caddy pour les uploads (ex : https://cdn.baraka.tn/u)
STORAGE_PUBLIC_URL=http://localhost:3001/u
# Si STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Paiements ---
# Fournisseurs actifs (séparés par des virgules) : cash,konnect,stripe
PAYMENT_PROVIDERS=cash
DEFAULT_CURRENCY=TND
# Konnect (https://konnect.network) — TND, montants en millimes
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_WEBHOOK_URL=http://localhost:3001/v1/payments/webhooks/konnect
# Stripe (dormant — entité UE future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Notifications push (Expo) ---
EXPO_ACCESS_TOKEN=

# --- Cartes / géocodage ---
MAP_TILES_URL=https://tiles.openfreemap.org/styles/liberty
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Observabilité ---
SENTRY_DSN=
LOG_LEVEL=info
