# ─────────────────────────────────────────────────────────────
# Baraka — variables de la stack de production (Raspberry Pi)
# Copier vers infra/compose/.env
# ─────────────────────────────────────────────────────────────

# Registre d'images & tag (poussés par la CI sur GHCR)
REGISTRY=ghcr.io/<votre-user-github>
TAG=latest

# Domaines (gérés par Cloudflare)
DOMAIN=baraka.tn
API_DOMAIN=api.baraka.tn
PUBLIC_WEB_URL=https://baraka.tn
PUBLIC_API_URL=https://api.baraka.tn
CORS_ORIGINS=https://baraka.tn
STORAGE_PUBLIC_URL=https://baraka.tn/u

# Base de données
POSTGRES_USER=baraka
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=baraka

# Secrets applicatifs
AUTH_SECRET=generer_avec_openssl_rand_hex_32

# Paiements
PAYMENT_PROVIDERS=cash,konnect
KONNECT_API_URL=https://api.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Notifications push
EXPO_ACCESS_TOKEN=

# Cloudflare Tunnel (token du connecteur)
CLOUDFLARE_TUNNEL_TOKEN=

# Observabilité
SENTRY_DSN=
